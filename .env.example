# Web3Forms access key (https://web3forms.com). The form sends submissions straight from
# the browser to Web3Forms, which e-mails them to the address the key was created for.
# This key is meant to be public.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional fallback when no Web3Forms key is set: a webhook that receives submissions as JSON.
QUOTE_WEBHOOK_URL=
